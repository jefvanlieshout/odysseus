#!/usr/bin/env python3
"""Small maintainer utility for building assistant update archives (format v2 when patches are present)."""
from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path, PurePosixPath
import tarfile
import tempfile


def sha256(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def safe_rel(raw: str) -> Path:
    p = PurePosixPath(raw)
    if p.is_absolute() or not p.parts or any(part in {"", ".", ".."} for part in p.parts):
        raise SystemExit(f"Unsafe repository-relative path: {raw!r}")
    return Path(*p.parts)


def main() -> int:
    p = argparse.ArgumentParser()
    p.add_argument("--from-version", required=True)
    p.add_argument("--to-version", required=True)
    p.add_argument("--message", required=True)
    p.add_argument("--output", type=Path, required=True)
    p.add_argument(
        "--delete", action="append", default=[], metavar="PATH",
        help="Repository-relative file to remove. Repeat for multiple files.",
    )
    p.add_argument(
        "--patch", action="append", default=[], metavar="PATCH=TARGET[,TARGET...]",
        help=(
            "Include a unified Git patch and declare the already-tracked repository "
            "paths it may modify. Repeat for multiple patches."
        ),
    )
    p.add_argument("paths", nargs="*")
    a = p.parse_args()
    if not a.paths and not a.delete and not a.patch:
        raise SystemExit("An update must contain at least one changed, deleted, or patched file.")

    root = Path.cwd().resolve()
    files = []
    patches = []
    deletes = [safe_rel(raw).as_posix() for raw in a.delete]
    if len(set(deletes)) != len(deletes):
        raise SystemExit("Duplicate --delete path supplied.")

    with tempfile.TemporaryDirectory() as td:
        staging = Path(td)
        (staging / "files").mkdir()
        seen: set[str] = set()
        for raw in a.paths:
            rel_input = safe_rel(raw)
            src = (root / rel_input).resolve()
            try:
                rel = src.relative_to(root)
            except ValueError:
                raise SystemExit(f"Path escapes repository: {raw}")
            rel_s = rel.as_posix()
            if rel_s in seen:
                raise SystemExit(f"Duplicate file path: {rel}")
            if rel_s in deletes:
                raise SystemExit(f"Path cannot be both changed and deleted: {rel}")
            seen.add(rel_s)
            if not src.is_file():
                raise SystemExit(f"Not a file: {rel}")
            dst = staging / "files" / rel
            dst.parent.mkdir(parents=True, exist_ok=True)
            dst.write_bytes(src.read_bytes())
            mode = oct(src.stat().st_mode & 0o777)[2:].zfill(4)
            files.append({"path": rel_s, "sha256": sha256(dst), "mode": mode})

        patch_dir = staging / "patches"
        patch_dir.mkdir()
        patch_names: set[str] = set()
        for spec in a.patch:
            if "=" not in spec:
                raise SystemExit(
                    f"Invalid --patch {spec!r}; expected PATCH=TARGET[,TARGET...]"
                )
            patch_raw, targets_raw = spec.split("=", 1)
            patch_src = Path(patch_raw).expanduser().resolve()
            if not patch_src.is_file():
                raise SystemExit(f"Patch file not found: {patch_src}")
            targets = [
                safe_rel(item.strip()).as_posix()
                for item in targets_raw.split(",")
                if item.strip()
            ]
            if not targets:
                raise SystemExit(f"Patch {patch_src} declares no targets")
            if len(set(targets)) != len(targets):
                raise SystemExit(f"Patch {patch_src} declares duplicate targets")
            payload_name = patch_src.name
            if payload_name in patch_names:
                raise SystemExit(f"Duplicate patch payload name: {payload_name}")
            patch_names.add(payload_name)
            dst = patch_dir / payload_name
            dst.write_bytes(patch_src.read_bytes())
            patches.append({
                "path": payload_name,
                "sha256": sha256(dst),
                "targets": targets,
            })

        manifest = {
            "format_version": 2 if patches else 1,
            "project": "assistant-stack",
            "from_versions": [a.from_version],
            "to_version": a.to_version,
            "message": a.message,
            "commit_message": f"Assistant update {a.to_version}",
            "files": files,
            "delete": deletes,
            "patches": patches,
            "deploy": [],
        }
        (staging / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
        a.output.parent.mkdir(parents=True, exist_ok=True)
        with tarfile.open(a.output, "w:gz") as tf:
            tf.add(staging / "manifest.json", arcname="manifest.json")
            tf.add(staging / "files", arcname="files")
            if patches:
                tf.add(staging / "patches", arcname="patches")
    print(a.output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
