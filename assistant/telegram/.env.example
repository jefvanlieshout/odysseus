# Telegram token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_ALLOWED_USER_IDS=

ODYSSEUS_API_TOKEN=ody_replace_me
ODYSSEUS_URL=http://odysseus:7000
ODYSSEUS_SESSION_NAME=Telegram Jarvis
ODYSSEUS_SESSION_ID=
ODYSSEUS_NETWORK=odysseus_default
ODYSSEUS_USE_WEB=false
ODYSSEUS_USE_RESEARCH=false
ODYSSEUS_TIMEOUT_SECONDS=600
TELEGRAM_MAX_CHARS=3900
LOG_LEVEL=INFO

# Voice input
WHISPER_ENABLED=true
WHISPER_URL=http://odysseus-whisper:9000
WHISPER_TIMEOUT_SECONDS=120
WHISPER_MAX_AUDIO_BYTES=26214400
WHISPER_MAX_VOICE_SECONDS=600
TELEGRAM_ECHO_TRANSCRIPT=false

# Voice output: auto | on | off
TELEGRAM_VOICE_DEFAULT=auto
TELEGRAM_VOICE_STATE_FILE=/state/voice_modes.json

# Generic TTS contract; bundled backend is CPU-only Chatterbox Nano.
TTS_ENABLED=true
TTS_URL=http://chatterbox-nano-tts:8881/v1/audio/speech
TTS_MODEL=chatterbox-nano
TTS_VOICE=reference
TTS_SPEED=1.0
TTS_TIMEOUT_SECONDS=120
TTS_MAX_CHARS=4000
TTS_MAX_AUDIO_BYTES=20971520

# Keep the real voice reference outside Git.
TTS_VOICE_REFERENCE_PATH=/absolute/path/to/atlas-reference.wav
