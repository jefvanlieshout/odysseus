# Telegram token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace_me

# Leave blank on first boot if you do not know your numeric Telegram user ID.
# Send /whoami to the bot, then put the returned ID here and restart.
TELEGRAM_ALLOWED_USER_IDS=

# The ody_... token created in Odysseus. Chat scope is enough for V1.
ODYSSEUS_API_TOKEN=ody_replace_me

# Internal Docker URL
ODYSSEUS_URL=http://odysseus:7000

# Create an Odysseus chat with this exact name.
ODYSSEUS_SESSION_NAME=Telegram Jarvis

# Optional exact session UUID; if set, it overrides the name above.
ODYSSEUS_SESSION_ID=

# Usually this is odysseus_default
ODYSSEUS_NETWORK=odysseus_default

ODYSSEUS_USE_WEB=false
ODYSSEUS_USE_RESEARCH=false
ODYSSEUS_TIMEOUT_SECONDS=600
TELEGRAM_MAX_CHARS=3900
LOG_LEVEL=INFO
