# Generated locally by ./events.sh setup/start. Do not commit the real .env.
EVENTS_API_KEY=replace-with-random-secret
EVENTS_DATA_DIR=/data
EVENTS_MAX_MESSAGE_CHARS=3500
EVENTS_REMINDER_POLL_SECONDS=1
LOG_LEVEL=INFO
TELEGRAM_TIMEOUT_SECONDS=20

# Optional override. Leave blank for one private allowlisted Telegram user.
TELEGRAM_CHAT_ID=
