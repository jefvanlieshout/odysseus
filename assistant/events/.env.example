# Human-facing name only. Rename the assistant later by changing this value.
ASSISTANT_NAME=Jarvis

# Generate with: openssl rand -hex 32
EVENTS_API_KEY=replace-me-with-a-long-random-secret
EVENTS_DATA_DIR=/data
EVENTS_DEFAULT_COOLDOWN_SECONDS=600
EVENTS_MAX_MESSAGE_CHARS=3500
LOG_LEVEL=INFO

# Reuse the SAME bot token as the existing Telegram bridge.
# Sending outbound messages from this service does not create a second poller.
TELEGRAM_BOT_TOKEN=replace-me

# In the existing Telegram bridge, run /whoami and copy the Telegram chat ID.
TELEGRAM_CHAT_ID=replace-me
TELEGRAM_TIMEOUT_SECONDS=20
