# Local/private event-service configuration.
# Copying is normally unnecessary: ./events.sh start creates .env safely.

# Generated automatically by ./events.sh start if missing.
EVENTS_API_KEY=replace-me-with-a-long-random-secret

EVENTS_DATA_DIR=/data
EVENTS_DEFAULT_COOLDOWN_SECONDS=600
EVENTS_MAX_MESSAGE_CHARS=3500
LOG_LEVEL=INFO
TELEGRAM_TIMEOUT_SECONDS=20

# Normally leave this blank. The event service reuses TELEGRAM_BOT_TOKEN from
# assistant/telegram/.env and, when exactly one Telegram user is allowlisted,
# automatically uses that user's ID as the private chat ID.
#
# Set TELEGRAM_CHAT_ID explicitly for a group chat or when multiple users are
# allowlisted.
TELEGRAM_CHAT_ID=
